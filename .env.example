# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"
PAYPAL_SECRET_KEY="YOUR_PAYPAL_SECRET_KEY"

# RESEND_API_KEY: Optional. Secret key for transactional kiosk check-out/check-in emails.
# Sign up at https://resend.com to obtain a free key.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# Sending domain: emails go out from @packer.tools addresses, so packer.tools MUST be a verified domain in Resend
# (Resend dashboard -> Domains -> Add domain -> add the SPF/DKIM DNS records). Without it, Resend rejects every send.

# GCP_PRICING_API_KEY: Optional. Custom API key for fetching SKUs from the GCP Cloud Billing Catalog API.
# If omitted, Gemini API key is used as fallback, or the simulation gracefully uses real GCP published rates.
GCP_PRICING_API_KEY=""

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Places Autocomplete & Maps integration.
# Add your Google Maps Platform API key to dynamically autocomplete and populate cities & provinces.
GOOGLE_MAPS_PLATFORM_KEY=""



# --- Security configuration (v6.0.2) ---
# MCP connector (v6.1.0+): users sign in with their own Packer Tools account. NO shared MCP secrets are needed.
# ADMIN_API_KEY / MCP_CLIENT_SECRET are no longer used by the MCP server (safe to delete). ADMIN_API_KEY only
# remains as a fallback for DEVELOPER_API_KEY below.
ADMIN_API_KEY=""
# FIRESTORE_DATABASE_ID: optional override; defaults to firestoreDatabaseId from firebase-applet-config.json.
FIRESTORE_DATABASE_ID=""
# DEVELOPER_API_KEY: optional shared key for /api/developer/* (per-user keys also work).
DEVELOPER_API_KEY=""
# MCP_ALLOWED_REDIRECT_HOSTS: extra comma-separated OAuth redirect hosts (claude.ai / claude.com always allowed).
MCP_ALLOWED_REDIRECT_HOSTS=""
# CONTACT_INBOX: where contact-form messages are delivered.
CONTACT_INBOX="hi@packer.tools"
